#!/usr/bin/env bash
# Quality gate for the whole repository. Runs in every Mix project:
#   compile --warnings-as-errors, format --check-formatted, credo --strict, test --cover
#
# The coverage threshold lives in each project's mix.exs and is a floor that only moves up.
# CLAUDE.md § Coverage has the rule; lowering it is a human's call, not an agent's.
# and lints the measurement harness, which the gate cannot run (it needs btrfs, systemd
# and Nix on the operator's machine), so static analysis is all it will ever get.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "==> shell"
shellcheck -x bin/check bin/measure bin/release bin/worker-update bin/e2e-chat bin/hetzner-image \
  measure/lib/*.sh measure/workloads/*.sh \
  platform/priv/git-hooks/* worker/test/support/*.sh nix/worker-health/*.sh nix/worker-health/jobs/*.sh
shfmt -d -i 2 -ci -sr bin measure platform/priv/git-hooks worker/test/support nix/worker-health

# A machine that has never run this — a command pool's, not an operator's — has an empty
# MIX_HOME, and `mix check` goes straight to compiling: no alias in any project installs Hex or
# fetches deps, so Mix dies asking for Hex before a single check runs. Install and fetch when
# they are absent. Nothing here relaxes a check; it only gets Mix to where it can run them, and
# on a machine that already has both it is a no-op.
if ! mix hex.info > /dev/null 2>&1; then
  echo "==> hex"
  mix local.hex --force > /dev/null
  mix local.rebar --force > /dev/null
fi

for project in core worker platform; do
  echo "==> $project"
  (cd "$project" && mix deps.get > /dev/null && mix check)
done
