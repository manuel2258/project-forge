#!/usr/bin/env bash
# Quality gate for the whole repository. Runs in every Mix project:
#   compile --warnings-as-errors, format --check-formatted, credo --strict, test --cover
#
# The coverage threshold lives in each project's mix.exs and is a floor that only moves up.
# CLAUDE.md § Coverage has the rule; lowering it is a human's call, not an agent's.
# and lints the measurement harness, which the gate cannot run (it needs btrfs, systemd
# and Nix on the operator's machine), so static analysis is all it will ever get.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "==> shell"
# `.forge/commands/` is in the list because it is shell in this repository that the gate runs:
# a command state invokes those scripts, and one of them decides whether the gate itself is
# judged to have run (`.forge/commands/check.sh`). It was the only shell here nothing linted.
shellcheck -x bin/check bin/measure bin/release bin/worker-update bin/e2e-chat bin/hetzner-image \
  bin/lib/*.sh measure/lib/*.sh measure/workloads/*.sh .forge/commands/*.sh \
  platform/priv/git-hooks/* worker/test/support/*.sh nix/worker-health/*.sh nix/worker-health/jobs/*.sh
shfmt -d -i 2 -ci -sr bin measure .forge/commands platform/priv/git-hooks worker/test/support nix/worker-health

# Mix's caches live in ignored directories inside the checkout, so a ticket's next agent job
# inherits them instead of reinstalling Hex and refetching the registry. This script owns them:
# it creates them when they are cold, which is the one thing `bin/e2e-chat` must not do.
# `bin/lib/mix-cache.sh` has the why and is the only place either path is written.
#
# shellcheck source=bin/lib/mix-cache.sh
. bin/lib/mix-cache.sh
forge_mix_cache_ensure "$PWD"

# The platform's tests need a postgres on localhost:5432 (`platform/config/test.exs`), and a
# command pool's machine has the binaries from the devshell and no server, so `mix check` in
# `platform` died at "The database for Forge.Repo couldn't be created" on every machine that is
# not an operator's. Start one for the length of the run when nothing answers, and leave an
# operator's own alone — `pg_isready` asks in the protocol Ecto will use rather than guessing
# from an open port.
#
# This does make the gate start infrastructure it does not otherwise own. The alternatives were
# a postgres in the devshell or an environment override in `config/test.exs` with a server
# supplied per machine; this is the one that needs nothing outside the repository, and
# `CLAUDE.md` § Quality gate is where the choice is recorded. It relaxes no check: the suite
# runs against a real postgres either way, and against the operator's where there is one.
if ! pg_isready -h localhost -p 5432 -q; then
  echo "==> postgres"
  pgroot="$(mktemp -d)"
  trap 'pg_ctl -D "$pgroot/data" -m immediate stop > /dev/null 2>&1 || true; rm -rf "$pgroot"' EXIT
  # Scram over the loopback on a password made for this run, and `trust` only on the unix
  # socket, which lives in this private directory. A trusting superuser on 5432 is a shell for
  # every other process on the machine — `COPY … FROM PROGRAM` runs as whoever runs the gate —
  # and a shared command-pool machine is the case this whole block exists for. A password out of
  # `config/test.exs` would not help there: every job on such a machine has a checkout and could
  # read it. This one exists only in this process and the directory that goes with the run.
  (
    umask 077
    head -c 24 /dev/urandom | base64 | tr -d '\n=+/' > "$pgroot/pw"
  )
  FORGE_TEST_DB_PASSWORD="$(cat "$pgroot/pw")"
  export FORGE_TEST_DB_PASSWORD
  initdb -U postgres --auth-local=trust --auth-host=scram-sha-256 --pwfile="$pgroot/pw" \
    -D "$pgroot/data" > /dev/null
  rm -f "$pgroot/pw"
  pg_ctl -D "$pgroot/data" -l "$pgroot/server.log" -w \
    -o "-p 5432 -c listen_addresses=localhost -c unix_socket_directories=$pgroot" start > /dev/null
fi

for project in core worker platform; do
  echo "==> $project"
  (cd "$project" && mix deps.get > /dev/null && mix check)
done
