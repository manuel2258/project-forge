#!/usr/bin/env bash
# Quality gate for the whole repository. Runs in every Mix project:
#   compile --warnings-as-errors, format --check-formatted, credo --strict, test --cover
# (the platform's tests run as three partitions at once; see below)
#
# The coverage threshold lives in each project's mix.exs and is a floor that only moves up.
# CLAUDE.md § Coverage has the rule; lowering it is a human's call, not an agent's.
# and lints the measurement harness, which the gate cannot run (it needs btrfs, systemd
# and Nix on the operator's machine), so static analysis is all it will ever get.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "==> shell"
# `.forge/commands/` is in the list because it is shell in this repository that the gate runs:
# a command state invokes those scripts, and one of them decides whether the gate itself is
# judged to have run (`.forge/commands/check.sh`). It was the only shell here nothing linted.
shellcheck -x bin/check bin/measure bin/release bin/worker-update bin/e2e-chat bin/hetzner-image bin/look bin/changelog-add \
  bin/lib/*.sh measure/lib/*.sh measure/workloads/*.sh .forge/commands/*.sh \
  platform/priv/git-hooks/* platform/priv/hetzner/*.sh worker/test/support/*.sh nix/codex-update.sh nix/boot-menu.sh nix/system-update.sh nix/worker-health/*.sh nix/worker-health/jobs/*.sh nix/worker-update-boots/*.sh
shfmt -d -i 2 -ci -sr bin measure .forge/commands platform/priv/git-hooks platform/priv/hetzner worker/test/support nix/codex-update.sh nix/boot-menu.sh nix/system-update.sh nix/worker-health nix/worker-update-boots

# Mix's caches live in ignored directories inside the checkout, so a ticket's next agent job
# inherits them instead of reinstalling Hex and refetching the registry. This script owns them:
# it creates them when they are cold, which is the one thing `bin/e2e-chat` must not do.
# `bin/lib/mix-cache.sh` has the why and is the only place either path is written.
#
# shellcheck source=bin/lib/mix-cache.sh
. bin/lib/mix-cache.sh
forge_mix_cache_ensure "$PWD"

# The platform's tests need a postgres they can log in to (`platform/config/test.exs`), and a
# command pool's machine has the binaries from the devshell and no server, so `mix check` in
# `platform` died at "The database for Forge.Repo couldn't be created" on every machine that is
# not an operator's. Start one for the length of the run when there is none to log in to, and
# leave an operator's own alone.
#
# **The probe logs in rather than asking whether a port answers.** `pg_isready` says only that
# something there speaks the protocol, which is not the question the suite asks: a throwaway
# server that an earlier run left behind — its shell killed before the trap below could stop
# it — answers that and then refuses the suite's credentials, so the gate skipped starting its
# own and died at authentication with a live postgres on the port. A guard must use the same
# model as the operation it guards (`CLAUDE.md` § Rules), and the operation is a login.
#
# The server it starts is described in `bin/lib/test-postgres.sh`, which `bin/look` shares: a unix
# socket in a directory of its own, no TCP port, nothing else on the machine able to reach it.
#
# This does make the gate start infrastructure it does not otherwise own. The alternatives were
# a postgres in the devshell or a server supplied per machine; this is the one that needs nothing
# outside the repository, and `CLAUDE.md` § Quality gate is where the choice is recorded. It
# relaxes no check: the suite runs against a real postgres either way, and against the
# operator's where there is one.
if ! PGPASSWORD=postgres psql -h localhost -p 5432 -U postgres -d postgres -tAc 'select 1' \
  > /dev/null 2>&1; then
  echo "==> postgres"
  # shellcheck source=bin/lib/test-postgres.sh
  . bin/lib/test-postgres.sh
  trap forge_test_postgres_stop EXIT
  forge_test_postgres_start
fi

for project in core worker; do
  echo "==> $project"
  (cd "$project" && mix deps.get > /dev/null && mix check)
done

# The platform's tests are most of the gate's time, and they are bound by CPU, not by being serial.
# They were once: one BEAM ran 127 of 194 files one after another on one core while the others stood
# idle, so they run as three partitions of the same suite (`mix test --partitions 3`) side by side,
# each against a database and a directory of its own (`platform/config/test.exs`), a temporary
# directory (`TMPDIR`, below) and a port the kernel picks (`Forge.TestEndpoint`). Ticket 52 measured
# that without coverage on two cores: 522 s in one process, 365 s as two partitions, 322 s as three.
#
# **With coverage, on two cores, three partitions keep both cores busy** (ticket 68, 1cec7c8: 1724
# CPU-seconds in 883 s of wall time, so 97% of two cores), which makes the phase its CPU time over two:
# the only way to shorten it is to take CPU out. Where the CPU went is in `docs/design/git-hosting.md`
# § What a question costs (89,516 git processes, a third of it), `docs/design/look.md` § What a look
# costs (a Chromium per browser test) and in the cover-compile each partition does before its first
# test (75 CPU-seconds, measured at 1cec7c8). After ticket 68's changes the same phase took 1300
# CPU-seconds in 674 s on the same machine. Two partitions took 1216 in 718 s, so three still pay: the
# third costs 84 CPU-seconds (75 of them the cover compile) and a partition alone wants only about 1.3
# cores of two (the diagnosis: 521 CPU-seconds in 414 s, no coverage).
#
# **The BEAM's idle schedulers spin here for nothing.** An idle scheduler busy-waits before it
# sleeps, and three BEAMs and their git children share two cores, so each spin is CPU taken from
# another partition: with `+sbwt none` and its two siblings the partitions' BEAM CPU fell from 575 s
# to 479 s and the phase from 1659 to 1552 CPU-seconds (one run each, ticket 68's diagnosis). Set on
# the three `mix test` processes only, not on the compile or the other projects.
#
# A partitioned `--cover` run exports its coverage and reports none (Mix, `test.ex`): the threshold
# in `platform/mix.exs` is checked by `mix test.coverage`, which merges the exports, so the floor is
# still the gate's and still fails a run below it (exit 3).
echo "==> platform"
(
  cd platform
  mix deps.get > /dev/null
  mix check.static

  # **A second compile, in a new VM, before the partitions.** On a checkout that has not been built
  # (every command job's) the compile inside `check.static` is not the last word: the next `mix`
  # to run recompiles `forge_core` and the 31 modules of `forge` that depend on it, as measured on
  # a cold build (`mix compile` after `check.static` printed "Compiling 31 files"; warm, never).
  # Left to the partitions, each did it at the same moment in the same `_build` — a cold run showed
  # "redefining module" warnings from it. A compile in `check.static` itself does not help, since
  # it is the same VM. Why the first compile leaves them stale I did not find out.
  env MIX_ENV=test mix compile

  partitions=3
  logs="$(mktemp -d)"
  rm -rf cover

  # A partition's log is printed **as it finishes**, and every log not yet printed is printed when
  # this script is stopped (the command's timeout sends TERM). Printing them all at the end, after
  # waiting for all three, left a gate killed at its timeout with none of the suite's output: no
  # failure already seen and no test name, only a count of dots.
  printed=" "
  pids=()
  show() {
    echo "==> platform tests, partition $1 of $partitions"
    cat "$logs/$1.log"
    printed="$printed$1 "
  }
  # shellcheck disable=SC2329 # invoked by the trap below
  stopped() {
    kill "${pids[@]}" 2> /dev/null || true
    for i in $(seq 1 "$partitions"); do
      case "$printed" in *" $i "*) ;; *) show "$i" ;; esac
    done
    rm -rf "$logs"
    exit 143
  }
  trap stopped TERM INT
  trap 'rm -rf "$logs"' EXIT

  # A partition started by itself would build, and race the others to it: the compile is done once,
  # above, and each of these finds nothing to do.
  #
  # **Each has a `TMPDIR` of its own**, because some tests look at the system temporary directory
  # for what a request left behind (`plug-*/forge-download-*` must be empty after a download), which
  # another partition's request is writing into at that moment.
  for i in $(seq 1 "$partitions"); do
    mkdir "$logs/tmp$i"
    (
      status=0
      ERL_FLAGS="+sbwt none +sbwtdcpu none +sbwtdio none" \
        TMPDIR="$logs/tmp$i" MIX_TEST_PARTITION="$i" \
        mix test --partitions "$partitions" --cover > "$logs/$i.log" 2>&1 || status=$?
      # Written aside and moved into place: the file exists from the moment a redirection opens it,
      # before its content does, and a wait loop that read it there saw "" and failed a good gate.
      echo "$status" > "$logs/$i.rc.tmp"
      mv "$logs/$i.rc.tmp" "$logs/$i.rc"
    ) &
    pids+=("$!")
  done

  # Waits in this shell, in short sleeps, and not in a subshell with a `sleep 120` of its own: that
  # one outlived the script by up to two minutes and held its stdout open, so `bin/check | tail`
  # did not return when the gate had. Every two minutes it says how far each partition has got.
  failed=0
  seconds=0
  while [ "$(echo "$printed" | wc -w)" -lt "$partitions" ]; do
    sleep 2
    seconds=$((seconds + 2))
    for i in $(seq 1 "$partitions"); do
      # A wrapper that was itself killed (the memory ceiling takes whatever it picks) writes no
      # status, and the loop would wait for one until the command's timeout.
      if [ ! -f "$logs/$i.rc" ] && ! kill -0 "${pids[$((i - 1))]}" 2> /dev/null &&
        [ ! -f "$logs/$i.rc" ]; then
        echo 255 > "$logs/$i.rc.tmp"
        mv "$logs/$i.rc.tmp" "$logs/$i.rc"
      fi
      if [ -f "$logs/$i.rc" ]; then
        case "$printed" in *" $i "*) ;; *)
          show "$i"
          [ "$(cat "$logs/$i.rc")" = 0 ] || failed=1
          ;;
        esac
      fi
    done
    if [ $((seconds % 120)) = 0 ]; then
      for i in $(seq 1 "$partitions"); do
        echo "    partition $i: $(tr -cd . < "$logs/$i.log" | wc -c) dots so far"
      done
    fi
  done
  [ "$failed" = 0 ] || exit 1

  # `mix test.coverage` with nothing to merge prints an error and exits 0, which would pass a gate
  # that never looked at the floor.
  exports="$(find cover -maxdepth 1 -name '*.coverdata' | wc -l)"
  if [ "$exports" -ne "$partitions" ]; then
    echo "expected $partitions coverage exports in platform/cover, found $exports" >&2
    exit 1
  fi

  mix test.coverage
)
