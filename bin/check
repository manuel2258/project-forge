#!/usr/bin/env bash
# Quality gate for the whole repository. Runs in every Mix project:
#   compile --warnings-as-errors, format --check-formatted, credo --strict, test --cover
#
# The coverage threshold lives in each project's mix.exs and is a floor that only moves up.
# CLAUDE.md § Coverage has the rule; lowering it is a human's call, not an agent's.
# and lints the measurement harness, which the gate cannot run (it needs btrfs, systemd
# and Nix on the operator's machine), so static analysis is all it will ever get.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "==> shell"
shellcheck -x bin/check bin/measure bin/release bin/worker-update bin/e2e-chat bin/hetzner-image \
  measure/lib/*.sh measure/workloads/*.sh \
  platform/priv/git-hooks/* worker/test/support/*.sh
shfmt -d -i 2 -ci -sr bin measure platform/priv/git-hooks worker/test/support

for project in core worker platform; do
  echo "==> $project"
  (cd "$project" && mix check)
done
