#!/usr/bin/env bash
# Publishes the platform image: one command, from a clean checkout of `main` to a version in the
# registry that a deployment can pin by digest.
#
#   bin/release [--registry REF] [--dry-run]
#
# What it does, in order: refuse anything but a clean `main`, log in, refuse a version the
# registry already holds, build `.#platform-image`, copy it to the registry as `<version>` and
# then as `latest`, and print the digest. A run that copied the version and stopped before
# `latest` moved is finished by running it again.
#
# **`latest` is the version just pushed, copied inside the registry**, so it names the same digest
# rather than a second upload of the same archive that might not. It only ever moves forward: this
# runs from a clean `main` and publishes the `VERSION` there, which is the newest release. A
# deployment still pins the digest; `latest` is for finding the current one, and for a quick try.
#
# **The version comes from `VERSION` and from nowhere else, and the registry says whether it has
# been published.** `flake.nix` reads the same file for the image tag and every `mix.exs` reads
# it for the release, so a run from a later commit that did not bump it would put a second build
# under the same tag. An image tag is worth pinning only if it means one build, so a version the
# registry already holds stops the run before anything is built. It used to be a git tag,
# `v<version>`, made and pushed first; a release runs unattended now (the `land` skill), from
# machines that may push branches and not tags, so the guard moved to the registry it protects.
# In git, the `chore(release): X.Y.Z` commit on `main` is what marks a release — `Version X.Y.Z`
# up to 0.15.0, so anything looking for the last one matches both (`CLAUDE.md` § Commit messages).
# Nothing in this script parses it; the two places that do are prose.
#
# There is deliberately no `--version`. There was, and it set the registry tag while `nix build`
# went on reading `VERSION` — so `--version 1.2.3` on a `0.1.1` tree pushed an image labelled
# `0.1.1` to the registry tag `1.2.3`. That is the exact "two different images claim one version"
# this file exists to prevent, reachable by a flag it offered.
#
# **No Docker daemon.** `nix build` writes a gzipped docker-archive tarball and `skopeo` copies it
# straight to the registry; containers/image auto-decompresses a docker-archive, so the gzip
# `dockerTools.buildLayeredImage` produces needs no `docker load` in between. It does spool the
# decompressed archive through $TMPDIR, so that needs room for an uncompressed image.
#
# Credentials, in order: `GHCR_TOKEN` if it is set, else `GITHUB_TOKEN`, else the GitHub CLI's own
# token if `gh` is installed and logged in, else whatever `skopeo login` already stored. `GHCR_USER` defaults to
# the registry path's owner. The `gh` step is why publishing needs no second secret: a login that
# can already push to the repository carries `write:packages`, and asking an operator to mint a
# PAT that duplicates a credential they have is how tokens end up pasted into shell history.
set -euo pipefail
cd "$(dirname "$0")/.."

registry="ghcr.io/manuel2258/forge"
dry_run=false

usage() {
  sed -n '2,10p' "$0" >&2
  exit 64
}

while [ $# -gt 0 ]; do
  case "$1" in
    --registry)
      registry="$2"
      shift 2
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    *) usage ;;
  esac
done

say() { printf '==> %s\n' "$1"; }
die() {
  printf 'bin/release: %s\n' "$1" >&2
  exit 1
}

# The image output is gated on `stdenv.hostPlatform.isLinux` in flake.nix, because an image's
# contents are Linux binaries: on darwin the attribute does not exist at all.
[ "$(uname -s)" = "Linux" ] || die "the platform image builds on Linux only"

command -v nix > /dev/null || die "nix is not on PATH; enter the devshell with \`nix develop\`"
command -v skopeo > /dev/null || die "skopeo is not on PATH; enter the devshell with \`nix develop\`"

version=$(cat VERSION)
[ -n "$version" ] || die "VERSION is empty"

branch=$(git rev-parse --abbrev-ref HEAD)
[ "$branch" = "main" ] || die "on $branch: a release is published from main (CLAUDE.md § Landing)"
[ -z "$(git status --porcelain)" ] || die "the working tree is dirty; commit or stash first"

destination="docker://$registry:$version"
latest="docker://$registry:latest"

digest_file=$(mktemp)
auth_file=$(mktemp)
trap 'rm -f "$digest_file" "$auth_file"' EXIT

# **The token does not go in argv.** `--dest-creds "user:$GHCR_TOKEN"` put it in the process
# table, readable by `ps` for every local user for as long as the copy ran — and a push of a
# gigabyte-and-a-quarter image is not a short window. `skopeo login --password-stdin` writes it
# to a file this script owns and deletes on exit instead.
#
# `gh auth token` is tried second because it is the credential the operator already has: `gh`'s
# own scopes include `write:packages`, so a machine that can push to the repository can push the
# image. It is optional and stays optional — `gh` is not in the devshell, so `command -v` decides,
# and a machine without it falls through to whatever `skopeo login` stored.
# `GITHUB_TOKEN` is read here rather than left to `gh`, which honours it too, because `gh` is not
# in the devshell: an unattended release (the `land` skill) has the variable and may not have `gh`.
#
# **Logged in before the build**, because the registry is asked below whether the version is
# already there, and a build that ends in a refused login is a long way to find that out.
token=${GHCR_TOKEN:-${GITHUB_TOKEN:-}}

if [ -z "$token" ] && command -v gh > /dev/null; then
  token=$(gh auth token 2> /dev/null || true)
  if [ -n "$token" ]; then say "using the gh CLI's token"; fi
fi

creds=()
src_creds=()
inspect_creds=()
if [ -n "$token" ]; then
  registry_host=${registry%%/*}
  user=${GHCR_USER:-$(echo "$registry" | cut -d/ -f2)}
  say "logging in to $registry_host as $user"
  # **Seeded with `{}` because skopeo reads this file before it writes it**, and `mktemp` leaves
  # it empty — which is not JSON, and skopeo dies with `unexpected end of JSON input` rather than
  # treating an empty file as no credentials. Found the hard way, half way through a release.
  printf '{}' > "$auth_file"
  printf '%s' "$token" |
    skopeo login --username "$user" --password-stdin --authfile "$auth_file" "$registry_host"
  creds=(--dest-authfile "$auth_file")
  src_creds=(--src-authfile "$auth_file")
  inspect_creds=(--authfile "$auth_file")
fi

# What the registry holds under `$1`, or nothing when it holds no such tag. Any other failure — a
# refused login, a registry that is down — stops the run: "not there" and "could not ask" are
# different answers, and reading the second as the first is how a version gets published twice.
digest_of() {
  local out
  if out=$(skopeo inspect "${inspect_creds[@]}" --format '{{.Digest}}' "$1" 2>&1); then
    printf '%s' "$out"
  elif ! grep -q 'manifest unknown\|name unknown' <<< "$out"; then
    die "cannot ask the registry about $1: $out"
  fi
}

# **Asked before the build, which is long.** A version the registry holds is a release already
# made, and publishing it again would be a second build under one tag — unless `latest` does not
# name it yet, which is a run that stopped between the two copies, and is finished here.
#
# Each answer is its own assignment, so a failure to ask stops the run under `set -e`; inside a
# test's arguments it would read as an empty digest.
published=$(digest_of "$destination")
if [ -n "$published" ]; then
  current=$(digest_of "$latest")
  [ "$current" != "$published" ] ||
    die "$registry:$version is already published ($published); bump VERSION to publish another build"
  if [ "$dry_run" = true ]; then
    say "would copy $destination, already published, to $latest"
    exit 0
  fi
  say "$registry:$version is already published; copying it to $latest"
  skopeo --insecure-policy copy "${src_creds[@]}" "${creds[@]}" "$destination" "$latest"
  say "published"
  printf '    %s@%s\n' "$registry" "$published"
  exit 0
fi

say "building .#platform-image"
archive=$(nix build .#platform-image --no-link --print-out-paths | tail -1)
echo "    $archive"

if [ "$dry_run" = true ]; then
  say "would copy to $destination, and then to $latest"
  exit 0
fi

say "copying to $destination"
# `--insecure-policy` is about signature policy and nothing else: skopeo refuses to run at all
# without a containers `policy.json`, which a devshell has no reason to have and NixOS only
# installs with the container stack. Nothing here signs or verifies image signatures — what a
# deployment pins is the digest printed below, which the registry cannot forge.
skopeo --insecure-policy copy \
  "${creds[@]}" --digestfile "$digest_file" "docker-archive:$archive" "$destination"

say "copying $destination to $latest"
skopeo --insecure-policy copy "${src_creds[@]}" "${creds[@]}" "$destination" "$latest"

say "published"
printf '    %s@%s\n' "$registry" "$(cat "$digest_file")"
